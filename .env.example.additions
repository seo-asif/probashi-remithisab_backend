# Merge into your .env (local development).

# Login token lifetime in minutes (default 43200 = 30 days)
REMIT_TOKEN_TTL_MINUTES=43200

# Email codes (these are the defaults; change only if you need to)
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESET_TICKET_TTL_MINUTES=10

# Google sign-in: comma separated OAuth client IDs (Android, iOS, web). Leave empty until you set up Google.
GOOGLE_CLIENT_IDS=

# Email while developing on your own computer:
#   MAIL_MAILER=log   writes each email, including the code, into storage/logs/laravel.log (LOCAL ONLY, never production)
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Probashi RemitHisab"

# Email codes are sent by a queued job.
#   QUEUE_CONNECTION=sync       sends immediately (easiest while developing)
#   QUEUE_CONNECTION=database   needs "php artisan queue:work" running, otherwise no email is ever sent
QUEUE_CONNECTION=sync
