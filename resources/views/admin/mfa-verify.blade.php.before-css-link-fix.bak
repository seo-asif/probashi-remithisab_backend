<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Administrator verification</title><link rel="stylesheet" href="{ asset('css/admin/auth-mfa-verify.css') }"></head><body><main><h1>Verify administrator login</h1><p>Enter the six-digit code from your authenticator app.</p>@if($errors->any())<p role="alert" class="error">{{ $errors->first() }}</p>@endif<form method="post" action="{{ route('admin.mfa.submit') }}">@csrf<label for="code">Authenticator code</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required><button type="submit">Verify and continue</button></form><hr><h2>Use a recovery code</h2><p>Enter one of your single-use recovery codes if your authenticator is unavailable.</p><form method="post" action="{{ route('admin.mfa.recovery') }}">@csrf<label for="recovery_code">Recovery code</label><input id="recovery_code" name="recovery_code" maxlength="32" minlength="32" autocomplete="off" spellcheck="false" required><button type="submit">Use recovery code</button></form></main></body></html>
