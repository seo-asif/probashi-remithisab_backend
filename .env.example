APP_NAME="Probashi RemitHisab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The app needs MySQL (tests also run on MySQL, see phpunit.xml).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=probashi_remithisab
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# OTP emails are queued. With "database" you must run: php artisan queue:work
# For quick local testing without a worker you can use: QUEUE_CONNECTION=sync
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local: "log" writes emails (with the OTP code) to storage/logs/laravel.log.
# Later: smtp (free provider) or resend/ses/postmark (paid).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Probashi RemitHisab (config/remit.php) ----
REMIT_DEFAULT_TIMEZONE=Pacific/Fiji
REMIT_TOKEN_TTL_MINUTES=43200

OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESET_TICKET_TTL_MINUTES=10

# Comma separated Google OAuth client IDs (Android, iOS, web). Empty = Google sign-in refused.
GOOGLE_CLIENT_IDS=
